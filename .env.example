# Copy this file to `.env` and replace every placeholder before starting the stack.
# `.env` is ignored by git; this example must never contain a working secret.

# --- Backend API -----------------------------------------------------------
# DSN used by the backend and by the migrations.
DATABASE_URL=postgresql+psycopg://postgres:change-me@localhost:5432/ticketplus
# DSN used by pytest. The database name must end in `_test`.
TEST_DATABASE_URL=postgresql+psycopg://postgres:change-me@localhost:5432/ticketplus_test

# Ed25519 signing key, base64 of the DER PKCS#8 private key, on one line.
# Generate it with:
#   uv run python -c "from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey as K; from cryptography.hazmat.primitives import serialization as s; import base64; print(base64.b64encode(K.generate().private_bytes(s.Encoding.DER, s.PrivateFormat.PKCS8, s.NoEncryption())).decode())"
JWT_PRIVATE_KEY_B64=replace-with-the-generated-key

# Backend settings with their defaults.
# APP_NAME is intentionally unset: both applications read this file and each
# has its own default ("backend" and "web").
LOG_LEVEL=INFO
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600
SQL_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE_SECONDS=1800

# --- Web application -------------------------------------------------------
# Internal URL of the API. The browser never uses this value.
API_BASE_URL=http://127.0.0.1:8000
# Flask session signing secret. Replace it; the application default is unsafe.
SECRET_KEY=replace-with-a-random-secret
# Local development runs over HTTP, so the Secure cookie flag must be off.
# Production must set it to true.
SESSION_COOKIE_SECURE=false

# Web settings with their defaults.
API_TIMEOUT_SECONDS=5.0

# --- Compose PostgreSQL ----------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ticketplus
